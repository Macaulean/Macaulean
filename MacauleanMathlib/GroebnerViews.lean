import MacauleanMathlib.GroebnerChecker
import Macaulean.Verification.CertificateData

namespace Macaulean.M2.Verification.GroebnerViews
open Macaulean.Algebra CertificateData
open Macaulean.Verification.Mathlib

abbrev PairRows (r : PolynomialRing) := List (List (List (RingPolynomial r)))

def readPairRows (r : PolynomialRing) (rows : List (List (List Value))) : Except String (PairRows r) :=
  rows.mapM (readRows r)

def checkGroebner (G : BasisPresentation r) (rows : PairRows r) : Bool :=
  GroebnerCertificates.checkBasis (G.output.generators.map RingPolynomial.data)
    (rows.map fun rs => rs.map fun row => row.map RingPolynomial.data)

noncomputable section
set_option backward.isDefEq.respectTransparency false

/-- The ideal generated by the actual exported input polynomials in Mathlib. -/
def idealMeaning (I : IdealPresentation r) : Ideal (MvPolynomial (Fin r.names.length) r.coefficients.Carrier) :=
  Ideal.span (polynomial '' {g | g ∈ I.generators.map RingPolynomial.data})

def basisMeaning (G : BasisPresentation r) : Set (MvPolynomial (Fin r.names.length) r.coefficients.Carrier) :=
  Set.range (fun i : Fin G.output.generators.length => polynomial G.output.generators[i].data)

private theorem range_generators (G : BasisPresentation r) :
    basisMeaning G = polynomial '' {g | g ∈ G.output.generators.map RingPolynomial.data} := by
  ext p
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨_, List.mem_map.mpr ⟨_, List.getElem_mem .., rfl⟩, rfl⟩
  · rintro ⟨g, hg, rfl⟩
    obtain ⟨q, hq, rfl⟩ := List.mem_map.mp hg
    obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp hq
    exact ⟨⟨i,hi⟩, rfl⟩

/-- A candidate is a Gröbner basis of the original ideal, not merely its own span. -/
theorem checkGroebner_sound (I : IdealPresentation r) (G : BasisPresentation r)
    (reverseRows : List (List (RingPolynomial r))) (rows : PairRows r)
    (heq : checkIdealEquality I G reverseRows = true)
    (hgb : checkGroebner G rows = true) :
    (grevlexOrder r.names.length).IsGroebnerBasis (basisMeaning G) (idealMeaning I) := by
  have hg := checkBasis_sound r.coefficients hgb
  have hi := worksheet_checked_sameIdeal r.coefficients heq
  have hr : Set.range (fun i : Fin (G.output.generators.map RingPolynomial.data).length =>
      polynomial (G.output.generators.map RingPolynomial.data)[i]) = basisMeaning G := by
    ext p
    constructor
    · rintro ⟨i, hi⟩
      refine ⟨⟨i.val, by simpa using i.isLt⟩, ?_⟩
      simpa only [Fin.getElem_fin, List.getElem_map] using hi
    · rintro ⟨i, hi⟩
      refine ⟨⟨i.val, by simpa using i.isLt⟩, ?_⟩
      simpa only [Fin.getElem_fin, List.getElem_map] using hi
  rw [hr] at hg
  rw [idealMeaning, hi, ← range_generators G]
  exact hg

end
end Macaulean.M2.Verification.GroebnerViews
